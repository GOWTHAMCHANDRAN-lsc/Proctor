# Copy to .env and fill in. Never commit .env.

GEMINI_API_KEY=

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=proctor_user
MYSQL_PASSWORD=
MYSQL_DATABASE=proctorguard

# Frontend
VITE_API_BASE=/api
VITE_SUPER_ADMIN_EMAILS=
VITE_FACE_MODELS_URL=/models
VITE_AI_API_URL=/api/ai

# SMTP (Gmail port 465 requires SMTP_SECURE=ssl)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT=20
SMTP_ALLOW_SELF_SIGNED=0

# Comma-separated origins allowed to call the API cross-origin (e.g. http://localhost:5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Session token signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=
# 1 = role/company only from verified session token; 1 = exam start requires signed access token
AUTH_ENFORCE_TOKEN=0
EXAM_ENFORCE_TOKEN=0

# Public origin used in server-built exam links (invitation emails, WhatsApp): <origin>/x/<code>
APP_ORIGIN=https://proctor.lsc-crm.in

# ---------------------------------------------------------------------------------------------
# WhatsApp notifications (optional) — see docs/WHATSAPP_SETUP.md.
# Everything is OFF until WHATSAPP_ENABLED=1 AND a provider with credentials AND at least one
# template name are set. While off nothing is sent and nothing is logged; email is unaffected.
# Changes take effect on the next request (no restart / rebuild).
# ---------------------------------------------------------------------------------------------
WHATSAPP_ENABLED=0
# meta = WhatsApp Cloud API (Meta) | lsc = LSC template gateway (contract in docs/WHATSAPP_SETUP.md)
WHATSAPP_PROVIDER=
# Prefixed to 10-digit numbers that are stored without a country code.
WHATSAPP_COUNTRY_CODE=91
# Language code the templates were approved in (e.g. en, en_US).
WHATSAPP_TEMPLATE_LANGUAGE=en
# Approved template NAMES, one per message kind. A kind left blank is simply not sent on WhatsApp.
#   INVITE:         {{1}} name, {{2}} exam title, {{3}} window, {{4}} duration, {{5}} exam link
#   REMINDER:       {{1}} name, {{2}} exam title, {{3}} window closes at, {{4}} exam link
#   REQUEST_UPDATE: {{1}} employee name, {{2}} request ref (#42), {{3}} exam title, {{4}} status
WHATSAPP_TEMPLATE_INVITE=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_REQUEST_UPDATE=
# --- provider = meta (WhatsApp Cloud API) ---
WHATSAPP_META_PHONE_NUMBER_ID=
# Permanent System User access token with whatsapp_business_messaging permission. Keep secret.
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_API_VERSION=v21.0
# Leave blank (https://graph.facebook.com). Only overridden to point tests at a local fake.
WHATSAPP_META_BASE_URL=
# --- provider = lsc (LSC template gateway — NOT the verification-code endpoint) ---
WHATSAPP_LSC_URL=
WHATSAPP_LSC_TOKEN=

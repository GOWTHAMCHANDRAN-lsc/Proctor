# Copy to .env and fill in. Never commit .env.

GEMINI_API_KEY=

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=proctor_user
MYSQL_PASSWORD=
MYSQL_DATABASE=proctorguard

# Frontend
VITE_API_BASE=/api
VITE_SUPER_ADMIN_EMAILS=
VITE_FACE_MODELS_URL=/models
VITE_AI_API_URL=/api/ai

# SMTP (Gmail port 465 requires SMTP_SECURE=ssl)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT=20
SMTP_ALLOW_SELF_SIGNED=0

# Comma-separated origins allowed to call the API cross-origin (e.g. http://localhost:5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Session token signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=
# 1 = role/company only from verified session token; 1 = exam start requires signed access token
AUTH_ENFORCE_TOKEN=0
EXAM_ENFORCE_TOKEN=0
